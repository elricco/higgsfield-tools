# Template: copy to .env or export directly in the terminal.
# You can find the values in the Higgsfield Console (https://console.higgsfield.ai).
HF_API_KEY=your-api-key-id
HF_API_SECRET=your-api-key-secret

# --- Client mode: talk to an hf server instead of Higgsfield (see docs/server.md) ---
# Do not set HF_SERVER here unless this machine should always be a client.
# HF_SERVER=http://127.0.0.1:8080
# HF_SERVER_TOKEN=

# --- Server mode (hf serve), webhooks: set both or none ---
# HF_WEBHOOK_SECRET=whsec_from_the_higgsfield_console
# HF_PUBLIC_URL=https://your-public-host

# Optional: never submit a job whose estimated cost is higher (USD per job).
# HF_MAX_USD=0.50
