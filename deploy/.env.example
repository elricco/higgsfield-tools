# Settings for hf serve (docker compose). Copy to deploy/.env – never commit the real file.
HF_API_KEY=your-api-key-id
HF_API_SECRET=your-api-key-secret
# Shared secret between agents and the server, e.g. from: openssl rand -hex 32
HF_SERVER_TOKEN=change-me

# Webhooks: set both or none (without them the server polls).
# HF_PUBLIC_URL=https://hf.example.com
# HF_WEBHOOK_SECRET=whsec_from_the_higgsfield_console

# Optional cost limit per job, enforced for all agents:
# HF_MAX_USD=0.50
# Models that may run despite an unknown price (comma-separated, or *):
# HF_ALLOW_UNPRICED=
